# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# local build and test artifacts
/build-output/
/output/
/test-results/
/page-snapshot.md
/tsconfig.tsbuildinfo

# local package/tool caches
/.npm-cache/
/.codegraph/
/.agents/
/.claude/
/.codex/
/.omo/
/.playwright-mcp/
/.playwright-cli/
/skills/
/.workbuddy-ai/

# 本项目用 npm 管理依赖；误跑 pnpm 产生的锁文件不入库
/pnpm-lock.yaml
/pnpm-workspace.yaml

# 一次性整理脚本（任务已完成，仅留档不入库）
/.copy-assets.mjs
/.organize-chapters.mjs
